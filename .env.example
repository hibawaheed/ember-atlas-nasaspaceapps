# All core features run without external services.
# Optional grounded language-model synthesis, routed through Vercel AI Gateway.
# Set a currently available provider/model identifier from https://ai-gateway.vercel.sh/v1/models.
AI_MODEL=
AI_GATEWAY_API_KEY=
# Keep disabled until rate limiting / access control is configured for a public launch.
ENABLE_GENERATIVE_AI=false
